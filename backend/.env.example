# 後端 API（開發用）。正式密鑰請用部署環境變數，勿提交真實密碼。
# SQLite：相對 backend/prisma/schema.prisma → 專案根 data/attendance.db（與 backend 並列）
DATABASE_URL="file:../../data/attendance.db"
PORT=3000
COOKIE_SECURE=false
# 正式 HTTPS 部署請設 COOKIE_SECURE=true，並更換下方 seed 密碼（勿用預設）
ADMIN_SEED_PASSWORD="ChangeMeAdmin!"
ADMIN_SEED_PIN="0000"
# ADMIN_SEED_PIN：僅舊欄位相容／seed 佔位；登入改圖形驗證碼後不作第二因子
